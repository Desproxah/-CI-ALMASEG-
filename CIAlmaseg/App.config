<?xml version="1.0" encoding="utf-8"?>
<configuration>

	<connectionStrings>
		<add name="ConexionCIAlmaseg"
			 connectionString="Data Source=(LocalDB)\MSSQLLocalDB;Initial Catalog=Ci.Almaseg.Ferreteria.Final;Integrated Security=True;Encrypt=False;Connect Timeout=10"
			 providerName="System.Data.SqlClient" />
	</connectionStrings>

	<appSettings>
		<add key="EnableWindowsFormsHighDpiAutoResizing" value="true" />
	</appSettings>

	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
	</startup>

</configuration>
